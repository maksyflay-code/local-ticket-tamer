# ==========================================================
# Configuração da instalação local (VM). Copie para docker/.env
# O instalador (scripts/install-vm.sh) gera as chaves para você.
# ==========================================================

# Endereço em que o sistema será acessado (IP ou domínio da VM)
SITE_URL=http://localhost:8080

# Portas publicadas na VM
APP_PORT=8080
SUPABASE_PORT=8000
POSTGRES_PORT_EXPOSED=5432

# URL pública da API (igual ao SITE_URL; o gateway encaminha internamente)
SUPABASE_PUBLIC_URL=http://localhost:8080
# URL da API do banco vista pelo servidor do app (rede interna do Docker)
SUPABASE_INTERNAL_URL=http://kong:8000

# Banco de dados
POSTGRES_DB=postgres
POSTGRES_PASSWORD=troque-esta-senha

# Segredos (gerados automaticamente pelo instalador)
JWT_SECRET=
SECRET_KEY_BASE=
ANON_KEY=
SERVICE_ROLE_KEY=

# Integrações opcionais (deixe vazio se não usar)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_KEY=
LOVABLE_API_KEY=
